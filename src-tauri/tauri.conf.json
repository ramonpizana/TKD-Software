{
  "productName": "TKD-Software",
  "version": "0.1.0",
  "identifier": "com.ramonpizana.tkdsoftware",
  "build": {
    "beforeBuildCommand": "node scripts/ensure-desktop-dist.mjs",
    "beforeDevCommand": "node scripts/tauri-before-dev.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist-desktop",
    "removeUnusedCommands": false
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 980,
        "label": "main",
        "minHeight": 760,
        "minWidth": 1280,
        "resizable": true,
        "title": "TKD-Software",
        "width": 1600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:tkd-software.db"]
    }
  }
}
