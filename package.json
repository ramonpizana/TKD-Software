{
  "name": "tkd-software",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dev": "node scripts/start-vite-dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "npm run prepare:runtime && node ./node_modules/vite/bin/vite.js preview --configLoader runner",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run prepare:runtime && node ./node_modules/vitest/vitest.mjs run --configLoader runner",
    "test:watch": "npm run prepare:runtime && node ./node_modules/vitest/vitest.mjs --configLoader runner",
    "validate": "npm run lint && npm run typecheck && npm run test && node scripts/build.mjs && node scripts/validate-repo.mjs",
    "desktop:doctor": "node scripts/check-desktop-prereqs.mjs",
    "desktop:dev": "npm run desktop:doctor && node scripts/run-tauri.mjs dev",
    "desktop:build": "npm run desktop:doctor && node scripts/run-tauri.mjs build",
    "desktop:artifacts": "node scripts/desktop-artifacts.mjs",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "create-tauri-app": "^4.6.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
